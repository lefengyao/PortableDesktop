<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 基础色板 ========== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF5F8"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#3D1A2E"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#3D1A2E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#FFF0F5"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#F2D4E0"/>

    <!-- ========== 强调色 ========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#F06292"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EC407A"/>
    <SolidColorBrush x:Key="IconContainerBrush" Color="#FCE4EC"/>

    <!-- ========== 标题栏按钮 ========== -->
    <SolidColorBrush x:Key="TitleBarButtonForegroundBrush" Color="#C090A0"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#F8E0E8"/>

    <!-- ========== 滚动条 ========== -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#E8C0D0"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FFF0F5"/>

    <!-- ========== 分隔线 ========== -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#F0D0DE"/>

    <!-- ========== 圆角值 ========== -->
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

    <!-- ========== 关闭按钮 ========== -->
    <SolidColorBrush x:Key="CloseButtonBackgroundBrush" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="CloseButtonForegroundBrush" Color="#E53E3E"/>
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#FFE0E0"/>

    <!-- ========== ComboBox ========== -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#FCE4EC"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#F0C8D8"/>
    <SolidColorBrush x:Key="ComboBoxHoverBorderBrush" Color="#F06292"/>

    <!-- ========== 阴影 ========== -->
    <Color x:Key="ShadowColor">#20000000</Color>
    <Color x:Key="CardShadowColor">#12000000</Color>

    <!-- ========== ComboBox 下拉项 ========== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#3D1A2E"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FCE4EC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F8BBD0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
