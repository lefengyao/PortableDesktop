<!--
    护眼绿主题 —— 只放颜色，不放结构。
    结构（圆角、控件模板、动效）统一在 Themes/Shared.xaml 里，
    切换主题时只会替换本文件，所以新增主题只要复制一份改色值即可。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 窗口与标题栏 ========== -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FAFDFB" Offset="0"/>
        <GradientStop Color="#EAF6EE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#16301F"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#16301F"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#DDEBE3"/>

    <!-- ========== 卡片 ========== -->
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FCFEFD" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#EDF8F1"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DDEBE2"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#BCE3CD"/>
    <Color x:Key="CardShadowColor">#FF000000</Color>

    <!-- ========== 强调色 ========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2FA36B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#268A59"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F6EE"/>

    <!-- ========== 图标盘 ========== -->
    <LinearGradientBrush x:Key="IconContainerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEF9F2" Offset="0"/>
        <GradientStop Color="#DFF2E7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IconContainerHotBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D5EEDF" Offset="0"/>
        <GradientStop Color="#C2E6D2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="IconPlateBorderBrush" Color="#CEE9DA"/>

    <!-- ========== 标题栏按钮 ========== -->
    <SolidColorBrush x:Key="TitleBarButtonForegroundBrush" Color="#5E8A70"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#E6F5EC"/>
    <SolidColorBrush x:Key="CloseButtonForegroundBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#E5484D"/>

    <!-- ========== 滚动条 ========== -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#BCDAC8"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#96C4A9"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#F0F9F3"/>

    <!-- ========== 下拉框 / 菜单 ========== -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#F1F9F4"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D2E7DA"/>
    <SolidColorBrush x:Key="ComboBoxHoverBorderBrush" Color="#2FA36B"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#E8F6EE"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#D3EEDF"/>

    <!-- ========== 空状态 / 拖拽遮罩 ========== -->
    <SolidColorBrush x:Key="EmptyStateBorderBrush" Color="#D3E5DA"/>
    <SolidColorBrush x:Key="EmptyStateForegroundBrush" Color="#7FA38D"/>
    <SolidColorBrush x:Key="EmptyStateTitleBrush" Color="#16301F"/>
    <SolidColorBrush x:Key="DropOverlayBrush" Color="#2FA36B"/>
    <SolidColorBrush x:Key="DropOverlayBorderBrush" Color="#2FA36B"/>

</ResourceDictionary>
