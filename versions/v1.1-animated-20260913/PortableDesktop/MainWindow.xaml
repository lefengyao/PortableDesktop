<Window x:Class="PortableDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PortableDesktop.Controls"
        xmlns:models="clr-namespace:PortableDesktop.Models"
        Title="便携桌面"
        Icon="pack://application:,,,/app.ico"
        Height="700" Width="500"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 空状态图标：很轻的呼吸感，提示"这里可以放东西" -->
        <Storyboard x:Key="EmptyStatePulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="EmptyIcon" Storyboard.TargetProperty="Opacity"
                             From="0.40" To="1" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- 外层圆角容器 -->
    <Border x:Name="WindowBorder"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            RenderOptions.BitmapScalingMode="HighQuality">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.25"
                              Color="#000000" RenderingBias="Performance"/>
        </Border.Effect>
        <Border.RenderTransform>
            <!-- 启动时整窗上浮渐显，用到的就是这个偏移 -->
            <TranslateTransform x:Name="WindowOffset" X="0" Y="14"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== 自定义标题栏 ========== -->
            <Border x:Name="TitleBarBorder" Grid.Row="0"
                    Height="48"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="{DynamicResource TitleBarCornerRadius}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：Logo + 标题 + 计数 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="8"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center" Margin="0,0,9,0">
                            <Grid Width="12" Height="12">
                                <Border Width="5" Height="5" CornerRadius="1.6" Background="#FFFFFF"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Width="5" Height="5" CornerRadius="1.6" Background="#FFFFFF" Opacity="0.72"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Border Width="5" Height="5" CornerRadius="1.6" Background="#FFFFFF" Opacity="0.72"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Width="5" Height="5" CornerRadius="1.6" Background="#FFFFFF" Opacity="0.48"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="便携桌面" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBarForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="CountChip" CornerRadius="7" Padding="7,2" Margin="9,0,0,0"
                                Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" Text="0 项" FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- 右侧：主题 + 窗口控制 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="ThemeComboBox"
                                  Width="92"
                                  Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <Button x:Name="MinButton" Content="&#xE921;"
                                Style="{StaticResource TitleBarButton}"
                                Click="MinButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <Button x:Name="MaxButton" Content="&#xE922;"
                                Style="{StaticResource TitleBarButton}"
                                Click="MaxButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <Button x:Name="CloseButton" Content="&#xE8BB;"
                                Style="{StaticResource TitleBarCloseButton}"
                                Click="CloseButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource SeparatorBrush}"
                       VerticalAlignment="Bottom" Margin="14,0"/>

            <!-- ========== 内容区域 ========== -->
            <Border x:Name="ContentBorder" Grid.Row="1"
                    CornerRadius="{DynamicResource ContentCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <!-- 空状态 -->
                    <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="252" Height="158" RadiusX="18" RadiusY="18"
                                   Stroke="{DynamicResource EmptyStateBorderBrush}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="5 4"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="EmptyIcon" Text="&#xE896;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       Foreground="{DynamicResource EmptyStateForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="把文件或快捷方式拖到这里"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource EmptyStateTitleBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="支持 .exe / .lnk / 文件夹 · 右键卡片可移除"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource EmptyStateForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 图标网格 -->
                    <ScrollViewer x:Name="ItemsScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  CanContentScroll="False"
                                  Background="Transparent">
                        <ItemsControl x:Name="ItemsHost" AlternationCount="10000" Margin="12,10,12,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DesktopItem}">
                                    <controls:ItemCard
                                        Item="{Binding}"
                                        IconService="{Binding IconService,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                        EntranceIndex="{Binding (ItemsControl.AlternationIndex),
                                                        RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                        LaunchRequested="Card_LaunchRequested"
                                        RevealRequested="Card_RevealRequested"
                                        RemoveRequested="Card_RemoveRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 拖入提示遮罩：两层，底层染色不透明度低，上层内容保持清晰 -->
                    <Grid x:Name="DropOverlay" Visibility="Collapsed" Opacity="0"
                          IsHitTestVisible="False">
                        <Border CornerRadius="{DynamicResource ContentCornerRadius}"
                                Background="{DynamicResource DropOverlayBrush}"
                                Opacity="0.13"/>
                        <Rectangle Width="236" Height="152" RadiusX="18" RadiusY="18"
                                   Stroke="{DynamicResource DropOverlayBorderBrush}"
                                   StrokeThickness="2"
                                   StrokeDashArray="6 4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                       Foreground="{DynamicResource DropOverlayBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="释放以添加到面板"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DropOverlayBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
