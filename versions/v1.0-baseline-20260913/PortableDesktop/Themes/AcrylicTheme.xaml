<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 基础色板 - 毛玻璃 ========== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F4FF"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#1A2744"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#1A2744"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#E8F0FF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D8E4F8"/>

    <!-- ========== 强调色 ========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00BCD4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0097A7"/>
    <SolidColorBrush x:Key="IconContainerBrush" Color="#E0F7FA"/>

    <!-- ========== 标题栏按钮 ========== -->
    <SolidColorBrush x:Key="TitleBarButtonForegroundBrush" Color="#5588AA"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#D8EEF8"/>

    <!-- ========== 滚动条 ========== -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B0C8E8"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#E8F0FC"/>

    <!-- ========== 分隔线 ========== -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#D0E0F4"/>

    <!-- ========== 圆角值 ========== -->
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

    <!-- ========== 关闭按钮 ========== -->
    <SolidColorBrush x:Key="CloseButtonBackgroundBrush" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="CloseButtonForegroundBrush" Color="#E53E3E"/>
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#FFE0E0"/>

    <!-- ========== ComboBox 样式 ========== -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#E8F0FC"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#C8D8F0"/>
    <SolidColorBrush x:Key="ComboBoxHoverBorderBrush" Color="#00BCD4"/>

    <!-- ========== ComboBox 下拉项 ========== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#1A2744"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D8EEF8"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C0E8F4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 窗口阴影资源 ========== -->
    <Color x:Key="ShadowColor">#20000000</Color>
    <Color x:Key="CardShadowColor">#12000000</Color>

</ResourceDictionary>
