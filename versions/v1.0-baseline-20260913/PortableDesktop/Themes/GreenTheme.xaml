<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 基础色板 - 护眼绿 ========== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EDF5EA"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#1B3A1B"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F5FAF3"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#1B3A1B"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F8FBF6"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#E6F3E2"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D4E8CE"/>

    <!-- ========== 强调色 ========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#43A047"/>
    <SolidColorBrush x:Key="IconContainerBrush" Color="#E8F5E9"/>

    <!-- ========== 标题栏按钮 ========== -->
    <SolidColorBrush x:Key="TitleBarButtonForegroundBrush" Color="#558866"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#D0E4CC"/>

    <!-- ========== 滚动条 ========== -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B8D4B4"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#E8F2E6"/>

    <!-- ========== 分隔线 ========== -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#D0E4CC"/>

    <!-- ========== 圆角值 ========== -->
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

    <!-- ========== 关闭按钮 ========== -->
    <SolidColorBrush x:Key="CloseButtonBackgroundBrush" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="CloseButtonForegroundBrush" Color="#E53E3E"/>
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#FFE0E0"/>

    <!-- ========== ComboBox 样式 ========== -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#E0ECD8"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#C4DCC0"/>
    <SolidColorBrush x:Key="ComboBoxHoverBorderBrush" Color="#66BB6A"/>

    <!-- ========== ComboBox 下拉项 ========== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#1B3A1B"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D0E8CC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#B8DCB4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 窗口阴影资源 ========== -->
    <Color x:Key="ShadowColor">#20000000</Color>
    <Color x:Key="CardShadowColor">#12000000</Color>

</ResourceDictionary>
