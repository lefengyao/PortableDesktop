<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 基础色板 ========== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F8FC"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#EEF0F8"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E8E8EF"/>

    <!-- ========== 强调色 ========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6C5CE7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A4BD1"/>
    <SolidColorBrush x:Key="IconContainerBrush" Color="#F0EDFF"/>

    <!-- ========== 标题栏按钮 ========== -->
    <SolidColorBrush x:Key="TitleBarButtonForegroundBrush" Color="#666680"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#E8E8F2"/>

    <!-- ========== 滚动条 ========== -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C0C0D0"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#F0F0F5"/>

    <!-- ========== 分隔线 ========== -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E0E0EB"/>

    <!-- ========== 圆角值 ========== -->
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

    <!-- ========== 关闭按钮 ========== -->
    <SolidColorBrush x:Key="CloseButtonBackgroundBrush" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="CloseButtonForegroundBrush" Color="#E53E3E"/>
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#FFE0E0"/>

    <!-- ========== ComboBox 样式 ========== -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#F0F0F8"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D0D0E0"/>
    <SolidColorBrush x:Key="ComboBoxHoverBorderBrush" Color="#6C5CE7"/>

    <!-- ========== ComboBox 下拉项 ========== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#1A1A2E"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E8EAF6"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D5D0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 窗口阴影资源 ========== -->
    <Color x:Key="ShadowColor">#20000000</Color>
    <Color x:Key="CardShadowColor">#12000000</Color>

</ResourceDictionary>
