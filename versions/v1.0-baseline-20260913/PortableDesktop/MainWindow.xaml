<Window x:Class="PortableDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="便携桌面"
        Icon="pack://application:,,,/app.ico"
        Height="700" Width="500"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        ResizeMode="CanResize">

    <!-- 外层圆角容器 -->
    <Border x:Name="WindowBorder"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            RenderOptions.BitmapScalingMode="HighQuality">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="6"
                              Opacity="0.25"
                              Color="#000000"
                              RenderingBias="Performance"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== 自定义标题栏 ========== -->
            <Border x:Name="TitleBarBorder" Grid.Row="0"
                    Height="44"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：Logo + 标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="#F8F9FC"
                                BorderBrush="#E0E0E8"
                                BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <Grid Width="13" Height="13">
                                <Border Width="12" Height="12" CornerRadius="3"
                                        Background="#FFFFFF"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="4.5" Height="4.5" CornerRadius="1.2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="1.5,1.5,0,0" Background="#4285F4"/>
                                <Border Width="4.5" Height="4.5" CornerRadius="1.2"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,1.5,1.5,0" Background="#EA4335"/>
                                <Border Width="4.5" Height="4.5" CornerRadius="1.2"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="1.5,0,0,1.5" Background="#FBBC04"/>
                                <Border Width="4.5" Height="4.5" CornerRadius="1.2"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,1.5,1.5" Background="#34A853"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="便携桌面" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBarForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右侧：主题 + 窗口控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- 主题下拉 -->
                        <Border Background="{DynamicResource ComboBoxBackgroundBrush}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                BorderBrush="{DynamicResource ComboBoxBorderBrush}"
                                BorderThickness="1"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="80" Height="26"
                                      FontSize="11"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{DynamicResource WindowForegroundBrush}"
                                      VerticalAlignment="Center"
                                      SelectedIndex="0"/>
                        </Border>

                        <!-- 最小化 -->
                        <Button x:Name="MinButton"
                                Content="&#xE921;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{DynamicResource TitleBarButtonForegroundBrush}"
                                Width="30" Height="30"
                                Cursor="Hand"
                                Click="MinButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                                            Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background"
                                                    Value="{DynamicResource TitleBarButtonHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 最大化/还原 -->
                        <Button x:Name="MaxButton"
                                Content="&#xE922;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{DynamicResource TitleBarButtonForegroundBrush}"
                                Width="30" Height="30"
                                Cursor="Hand"
                                Click="MaxButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                                            Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background"
                                                    Value="{DynamicResource TitleBarButtonHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 关闭 -->
                        <Button x:Name="CloseButton"
                                Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{DynamicResource CloseButtonForegroundBrush}"
                                Width="30" Height="30"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                                            Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background"
                                                    Value="{DynamicResource CloseButtonHoverBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource SeparatorBrush}"
                       VerticalAlignment="Bottom" Margin="16,0"/>

            <!-- ========== 内容区域 ========== -->
            <Border x:Name="ContentBorder" Grid.Row="1"
                    CornerRadius="0,0,16,16" Background="Transparent">
                <Grid>
                    <!-- 空状态提示 -->
                    <TextBlock x:Name="EmptyHint"
                               Text="拖拽文件或快捷方式到此处"
                               FontSize="14"
                               Foreground="{DynamicResource SeparatorBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="Visible"/>

                    <!-- 滚动图标网格 -->
                    <ScrollViewer x:Name="ItemsScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Background="Transparent">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Width" Value="6"/>
                            </Style>
                        </ScrollViewer.Resources>
                        <WrapPanel x:Name="ItemsPanel" Margin="12,8"/>
                    </ScrollViewer>

                    <!-- 拖入提示遮罩 -->
                    <Border x:Name="DropOverlay"
                            Background="#886C5CE7"
                            CornerRadius="0,0,16,16"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B0;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="36"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="释放以添加"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
